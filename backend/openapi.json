  "components": {
    "schemas": {
      "AcceptResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true,
            "title": "Ok",
            "default": true
          },
          "envelope_id": {
            "type": "string",
            "format": "uuid",
            "title": "Envelope Id"
          },
          "already_seen": {
            "type": "boolean",
            "title": "Already Seen",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "envelope_id"
        ],
        "title": "AcceptResponse"
      },
      "CoachingBatchIn": {
        "properties": {
          "coaching": {
            "items": {
              "$ref": "#/components/schemas/CoachingIn"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Coaching"
          }
        },
        "type": "object",
        "required": [
          "coaching"
        ],
        "title": "CoachingBatchIn"
      },
      "CoachingIn": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Session Id"
          },
          "consistency_score": {
            "type": "number",
            "title": "Consistency Score"
          },
          "trend": {
            "type": "string",
            "minLength": 1,
            "title": "Trend"
          },
          "focus_area": {
            "type": "string",
            "minLength": 1,
            "title": "Focus Area"
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "title": "Recommendation"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "consistency_score",
          "trend",
          "focus_area",
          "recommendation",
          "confidence",
          "timestamp"
        ],
        "title": "CoachingIn"
      },
      "CoachingOut": {
        "properties": {
          "consistency_score": {
            "type": "number",
            "title": "Consistency Score"
          },
          "trend": {
            "type": "string",
            "title": "Trend"
          },
          "focus_area": {
            "type": "string",
            "title": "Focus Area"
          },
          "recommendation": {
            "type": "string",
            "title": "Recommendation"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence"
          },
          "emitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Emitted At"
          }
        },
        "type": "object",
        "required": [
          "consistency_score",
          "trend",
          "focus_area",
          "recommendation",
          "confidence",
          "emitted_at"
        ],
        "title": "CoachingOut"
      },
      "EventIn": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Session Id"
          },
          "event_type": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Event Type"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "event_type",
          "timestamp"
        ],
        "title": "EventIn"
      },
      "EventOut": {
        "properties": {
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "event_type",
          "occurred_at",
          "payload"
        ],
        "title": "EventOut"
      },
      "EventsBatchIn": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventIn"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "EventsBatchIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LapIn": {
        "properties": {
          "session_id": {
            "type": "string",
